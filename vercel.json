{
  "cleanUrls": true,
  "images": {
    "sizes": [480, 960, 1600],
    "formats": ["image/webp"],
    "minimumCacheTTL": 2592000,
    "localPatterns": [{ "pathname": "^/img/uploads/.*$" }]
  },
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/admin/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
